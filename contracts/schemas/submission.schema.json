{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mememom.dev/schemas/submission-1/submission.schema.json",
  "title": "Mememom UGC Submission v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["submission_version", "submission_id", "creator_id", "state", "submitted_at", "sandbox_version", "sandbox_id", "snapshot", "audit"],
  "properties": {
    "submission_version": {"const": "submission-1"},
    "submission_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "creator_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "state": {"enum": ["submitted", "needs_information", "under_review", "approved_for_canon", "rejected", "withdrawn"]},
    "submitted_at": {"type": "string", "format": "date-time"},
    "sandbox_version": {"const": "sandbox-1"},
    "sandbox_id": {"type": "string", "minLength": 1},
    "snapshot": {"$ref": "#/$defs/snapshot"},
    "audit": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/audit"}}
  },
  "$defs": {
    "snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["sandbox_version", "sandbox_id", "name", "type", "flavor", "tags", "media_reference", "media_digest", "attribution", "source_reference", "rights_basis"],
      "properties": {
        "sandbox_version": {"const": "sandbox-1"}, "sandbox_id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1, "maxLength": 80}, "type": {"enum": ["classic", "reaction", "brainrot", "surreal", "wholesome"]}, "flavor": {"type": "string", "maxLength": 280}, "tags": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 40}}, "media_reference": {"type": "string", "minLength": 1, "maxLength": 1024}, "media_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "attribution": {"type": "string", "minLength": 1, "maxLength": 280}, "source_reference": {"type": "string", "minLength": 1, "maxLength": 280}, "rights_basis": {"type": "string", "minLength": 1, "maxLength": 280}
      }
    },
    "audit": {
      "type": "object", "additionalProperties": false,
      "required": ["actor_id", "actor_role", "from_state", "to_state", "at", "category", "rationale"],
      "properties": {"actor_id": {"type": "string", "minLength": 1}, "actor_role": {"enum": ["creator", "moderator", "admin"]}, "from_state": {"enum": ["draft", "submitted", "needs_information", "under_review"]}, "to_state": {"enum": ["submitted", "needs_information", "under_review", "approved_for_canon", "rejected", "withdrawn"]}, "at": {"type": "string", "format": "date-time"}, "category": {"type": "string", "maxLength": 40}, "rationale": {"type": "string", "maxLength": 280}}
    }
  }
}
